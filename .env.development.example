# ── Development (localhost) — copy to .env and adjust ─────────────────────
# Minimal SMTP + app URL settings for testing invoice emails with Mailpit.
# See docker-compose.yml and README notes below.

# Required by the app (keep your existing values if already set)
DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/hotel_booking
SECRET_KEY=dev-secret-change-me

# Public base URL of this API (used in invoice links: track / edit / cancel)
# Must match where uvicorn listens, e.g. http://localhost:8000
APP_BASE_URL=http://localhost:8000

# ── SMTP invoice delivery ───────────────────────────────────────────────────
# SMTP_ENABLED: set to "true" to send emails. Default in code is false (skipped).
SMTP_ENABLED=true

# Mailpit (docker-compose.yml): SMTP on 1025, Web UI on http://localhost:8025
# Use host "localhost" when the API runs on your machine (not inside Docker).
SMTP_HOST=localhost
SMTP_PORT=1025

# Mailpit accepts mail without authentication or TLS on port 1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM_EMAIL=noreply@hotel.local
