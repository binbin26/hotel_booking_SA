DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/hotel_booking
APP_NAME=Hotel Booking API
DEBUG=true
SECRET_KEY=change-me-in-production
ADMIN_TOKEN_COOKIE_NAME=admin_session
ADMIN_TOKEN_COOKIE_MAX_AGE=28800
ADMIN_COOKIE_SECURE=false

# Guest invoice email (set SMTP_ENABLED=true in production)
APP_BASE_URL=http://localhost:8000
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@hotel.com
SMTP_USE_TLS=true
SMTP_ENABLED=false
