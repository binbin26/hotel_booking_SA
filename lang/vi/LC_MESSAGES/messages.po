#: templates/index.html:248
msgid "Where stillness becomes the journey"
msgstr "Nơi sự tĩnh lặng trở thành hành trình"

#: templates/index.html:251
msgid ""
"Discover refined residences immersed in nature. Begin your stay with "
"dates that honor unhurried time."
msgstr ""
"Khám phá những căn hộ tinh tế giữa thiên nhiên. Bắt đầu kỳ nghỉ với "
"những ngày dành cho thời gian không vội vã."

#: templates/index.html:260 templates/index.html:323
msgid "Search availability"
msgstr "Tìm phòng trống"

#: templates/index.html:263
msgid "Plan your stay"
msgstr "Lên kế hoạch lưu trú"

#: templates/index.html:269 templates/index.html:522
